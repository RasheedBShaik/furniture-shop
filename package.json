{
  "name": "react",
  "version": "1.0.0",
  "description": "Full-stack project with pnpm monorepo setup",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "echo 'Nothing to build'",
    "start": "node backend/server.js",
    "server": "nodemon backend/server.js",
    "client": "pnpm --prefix frontend dev",
    "dev": "concurrently -n BACKEND,FRONTEND -c yellow,blue \"pnpm run server\" \"pnpm run client\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.13.1",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.562.0",
    "mongoose": "^9.1.2",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.1.11"
  }
}
